# MongoDB Connection String (Required for dev-api-server.js / serverless functions)
# For local MongoDB: mongodb://localhost:27017/UniMap
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net
MONGO_URL=mongodb://localhost:27017/UniMap

# API Base URL for Vite Frontend (Optional in production, set to http://localhost:3000 for local dev)
VITE_API_BASE_URL=http://localhost:3000

# EmailJS Service Credentials (Optional - required only for support form submissions)
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
