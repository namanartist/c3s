# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/c3s_db
DATABASE_USERNAME=c3s_user
DATABASE_PASSWORD=c3s_password

# JWT Authentication
JWT_SECRET=c3s_super_secure_enterprise_grade_jwt_signing_key_2026_at_least_256_bits_long_secure
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# QR Cryptographic Signing
QR_SIGNING_SECRET=c3s_daily_qr_cryptographic_hmac_secret_key_2026_mits

# Redis Cache & Rate Limiting
REDIS_HOST=localhost
REDIS_PORT=6379

# Server Timezone
APP_TIMEZONE=Asia/Kolkata

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Object Storage / Evidence Storage
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=c3s-evidence-vault
STORAGE_LOCAL_DIR=./storage/evidence

# Retention Policies (Days)
RETENTION_LOCATION_DAYS=30
RETENTION_AUDIT_DAYS=365
RETENTION_MOVEMENT_DAYS=180